{
  "productName": "Baccy",
  "version": "0.3.0",
  "identifier": "com.baccy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Baccy - BACnet Browser",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "DeveloperTool",
    "shortDescription": "BACnet browser and testing tool",
    "longDescription": "A cross-platform BACnet browser and testing tool for discovering and interacting with BACnet devices on your network."
  }
}
